# Copy this file to .env and fill in the values. .env is gitignored; never commit it.

# Local PostgreSQL (installed as service postgresql-x64-16)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=kalshi_vs_fed

# Optional: free key from https://fred.stlouisfed.org/docs/api/api_key.html
# (not required; the ALFRED CSV endpoints work without it)
FRED_API_KEY=
